rules_version = '2';
// 作品原価帳 の Firestore セキュリティルール
// 1. 下の OWNER_EMAILS を、作成者のGoogleアカウントのメールアドレスに書き換えてください。
// 2. Firebase コンソール → Firestore Database → ルール に全文を貼り付けて「公開」を押します。
service cloud.firestore {
  match /databases/{database}/documents {

    function owners() { return ['YOUR_EMAIL@gmail.com']; }  // ← OWNER_EMAILS

    function signedIn() { return request.auth != null; }
    function isOwner() {
      return signedIn() && request.auth.token.email_verified == true
        && request.auth.token.email in owners();
    }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function blocked() {
      let p = /databases/$(database)/documents/mod/settings;
      return exists(p) && get(p).data.get('blocked', {}).get(request.auth.uid, false) == true;
    }
    function selfWrite(uid) { return isOwner() || (isSelf(uid) && !blocked()); }

    // 公開中の作品（ユーザーごとに1ドキュメント）と写真
    match /showcase/{uid} {
      allow read: if true;
      allow write: if selfWrite(uid);   // showcase/guest（投稿コードの作品）は作成者だけ
      match /ph/{wid} {
        allow read: if true;
        allow write: if selfWrite(uid)
          && (request.resource == null || request.resource.data.photo.size() < 400000);
      }
    }

    // いいね・スーパーいいね（各自が自分のドキュメントだけ書ける）
    match /likes/{uid} {
      allow read: if true;
      allow write: if isOwner() || isSelf(uid);
    }

    // コメント（各自が自分のドキュメントに最大150件。作成者は削除のために全員分を書ける）
    match /comments/{uid} {
      allow read: if true;
      allow delete: if isOwner() || isSelf(uid);
      allow create, update: if selfWrite(uid)
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 150;
    }

    // 通報
    match /reports/{uid} {
      allow read: if true;
      allow write: if isOwner() || isSelf(uid);
    }

    // 表示名
    match /profiles/{uid} {
      allow read: if true;
      allow write: if isSelf(uid)
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 30;
    }

    // NGワード・ブロックなどの管理設定（作成者だけ）
    match /mod/{doc} {
      allow read: if true;
      allow write: if isOwner();
    }

    // 各自の帳簿（作品・パーツ）は本人だけが読み書きできる
    match /data/users/{uid}/{rest=**} {
      allow read, write: if isSelf(uid);
    }
  }
}
